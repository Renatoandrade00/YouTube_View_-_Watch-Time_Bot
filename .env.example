# Configurações do YouTube View & Watch-Time Bot
TARGET_URL=
URLS_FILE=urls.txt
WORKERS=10
TOTAL_VIEWS=
DURATION_HOURS=3.5
MIN_WATCH=1200
MAX_WATCH=2100
HEADLESS=true
MUTE_AUDIO=true
POLL_INTERVAL=5
ENABLE_ANTI_FINGERPRINT=true
ENABLE_MICRO_INTERACTIONS=true
MIN_DELAY_BETWEEN_VIDEOS=5.0
MAX_DELAY_BETWEEN_VIDEOS=15.0
LOG_LEVEL=INFO
SAVE_SESSION_LOGS=true
LOGS_DIR=logs

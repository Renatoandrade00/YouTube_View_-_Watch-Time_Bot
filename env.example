# Configurações do YouTube View & Watch-Time Bot
TARGET_URL=
URLS_FILE=urls.txt
WORKERS=5
TOTAL_VIEWS=
DURATION_HOURS=1.0
CONTINUOUS=true
MIN_WATCH=120
MAX_WATCH=300
HEADLESS=true
MUTE_AUDIO=true
POLL_INTERVAL=5.0
WORKER_STAGGER_DELAY=15.0

# Stealth & Comportamento Humano
ENABLE_ANTI_FINGERPRINT=true
ENABLE_MICRO_INTERACTIONS=true
SEARCH_AND_PLAY=false
MIN_DELAY_BETWEEN_VIDEOS=5.0
MAX_DELAY_BETWEEN_VIDEOS=15.0

# Otimização de Recursos & Auto-Recuperação
BLOCK_HEAVY_MEDIA=true
AUTO_PLAYER_RECOVERY=true

# Perfis Persistentes & Cookies
USE_PERSISTENT_PROFILES=false
PROFILES_DIR=profiles
COOKIES_FILE=

# Logging
LOG_LEVEL=INFO
SAVE_SESSION_LOGS=true
LOGS_DIR=logs

# Configurações de Proxy (Opcional)
ENABLE_PROXY=false
PROXIES_FILE=proxies.txt
PROXY_LOW_BANDWIDTH=true
PROXY_SESSION_TEMPLATE=
PROXY_QUARANTINE_MINUTES=30.0
